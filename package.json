{
  "name": "memory-platform",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "npm run build && node --test",
    "build": "node scripts/build.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew --no-daemon --max-workers=2 assembleDebug",
    "data:refresh": "python scripts/import-countries.py"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3"
  }
}
