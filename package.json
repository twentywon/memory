{
  "name": "memory-platform",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "npm run build && node --test",
    "build": "node scripts/build.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew --no-daemon --max-workers=2 assembleDebug && cd .. && node scripts/package-apk.mjs",
    "data:refresh": "python scripts/import-countries.py",
    "icons:android": "capacitor-assets generate --android --assetPath resources --iconBackgroundColor '#244F3F' --iconBackgroundColorDark '#244F3F' --splashBackgroundColor '#244F3F' --splashBackgroundColorDark '#244F3F'",
    "hanja:refresh": "python scripts/import-hanja.py"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3"
  }
}
